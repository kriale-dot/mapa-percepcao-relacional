{
  "name": "kriale/mapa-relacional-api",
  "description": "API do Mapa de Percepcao Relacional",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.8",
    "firebase/php-jwt": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8383 -t public",
    "migrate": "php bin/migrate.php",
    "check": [
      "php -l public/index.php",
      "php -l src/Config/Database.php",
      "php -l src/Config/LoggerFactory.php",
      "php -l src/Controller/HealthController.php",
      "php -l src/Middleware/CorsMiddleware.php",
      "php -l bin/migrate.php",
      "php -l bin/check-domain.php"
    ],
    "check-domain": "php bin/check-domain.php"
  }
}
