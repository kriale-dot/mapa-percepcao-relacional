{
  "name": "kriale/mapa-relacional-api",
  "description": "API da Avaliacao de Percepcao Relacional",
  "type": "project",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "vlucas/phpdotenv": "^5.6",
    "monolog/monolog": "^3.8",
    "firebase/php-jwt": "^6.10",
    "phpmailer/phpmailer": "^6.9"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8383 -t public",
    "migrate": "php bin/migrate.php",
    "check": [
      "php -l public/index.php",
      "php -l src/Config/Database.php",
      "php -l src/Config/LoggerFactory.php",
      "php -l src/Controller/HealthController.php",
      "php -l src/Middleware/CorsMiddleware.php",
      "php -l bin/migrate.php",
      "php -l bin/check-domain.php",
      "php -l bin/setup-professional.php",
      "php -l bin/check-professional.php",
      "php -l src/Controller/AuthController.php",
      "php -l src/Service/JwtService.php",
      "php -l src/Middleware/ProfessionalAuthMiddleware.php",
      "php -l src/Controller/ProfessionalController.php",
      "php -l src/Controller/InstrumentController.php",
      "php -l src/Controller/InstrumentVersionController.php",
      "php -l src/Controller/SectionController.php",
      "php -l src/Controller/ItemController.php",
      "php -l src/Controller/AlternativeController.php",
      "php -l src/Controller/PersonController.php",
      "php -l src/Controller/RelationshipController.php",
      "php -l src/Controller/ApplicationController.php",
      "php -l src/Controller/PublicEvaluationController.php",
      "php -l src/Service/AccessTokenService.php",
      "php -l src/Service/MailService.php",
      "php -l src/Controller/ParticipantAccessController.php",
      "php -l bin/check-smtp.php",
      "php -l src/Service/ResultService.php",
      "php -l src/Controller/ResultBandController.php",
      "php -l src/Controller/FeedbackController.php",
      "php -l src/Service/AuditService.php",
      "php -l src/Middleware/SecurityHeadersMiddleware.php",
      "php -l src/Controller/NotificationController.php",
      "php -l bin/check-v1.php",
      "php -l src/Controller/AuditController.php",
      "php -l src/Service/RateLimitService.php",
      "php -l bin/backup-db.php",
      "php -l src/Controller/SiteController.php",
      "php -l bin/clean-db-keep-professionals.php"
    ],
    "check-domain": "php bin/check-domain.php",
    "setup-professional": "php bin/setup-professional.php",
    "check-professional": "php bin/check-professional.php",
    "check-smtp": "php bin/check-smtp.php",
    "check-v1": "php bin/check-v1.php",
    "backup-db": "php bin/backup-db.php",
    "clean-db-keep-professionals": "php bin/clean-db-keep-professionals.php"
  }
}
